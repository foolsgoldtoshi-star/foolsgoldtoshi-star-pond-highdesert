{:paths ["phoenix-dsl/src" "scripts"]
 :deps  {org.clojure/clojurescript {:mvn/version "1.11.132"}
         org.clojure/spec.alpha   {:mvn/version "0.3.218"}
         http-kit/http-kit        {:mvn/version "2.8.0"}
         babashka/fs              {:mvn/version "0.5.20"}
         hiccup/hiccup           {:mvn/version "1.0.5"}
         markdown-clj/markdown-clj {:mvn/version "1.11.4"}}
 :tasks
 { :requires ([babashka.fs :as fs]
              [babashka.process :refer [shell]]
              [clojure.string :as str]
              [hiccup.core :as h]
              [markdown.core :as md])

  doctor {:doc "Check toolchain availability for sacred technology development"
          :task (do (println "🌙 Sacred Technology Toolchain Status")
                    (println "bb version:" (System/getProperty "babashka.version"))
                    (shell "bash" "-lc" "node --version || echo 'Node.js not found'")
                    (shell "bash" "-lc" "clojure -Sdescribe | head -n 3 || echo 'Clojure not found'")
                    (shell "bash" "-lc" "npx vite --version || echo 'Vite not found'")
                    (shell "bash" "-lc" "clj-kondo --version || echo 'clj-kondo not found'")
                    (shell "bash" "-lc" "zprint --version || echo 'zprint not found'"))}

  epub:generate {:doc "Generate sacred technology epub for contemplative reading"
                 :task (do (println "📚 Generating Sacred Technology Epub...")
                           (let [teachings (gather-sacred-teachings)]
                             (generate-contemplative-epub teachings)
                             (println "✨ Epub generation complete: build/sacred-technology.epub")))}

  fmt {:doc "Format code with contemplative attention (80 columns)"
       :task (shell "bash" "-lc" "zprint -w **/*.{clj,cljs,edn,bb,md} || true")}

  lint:kondo {:doc "Lint with consciousness for code quality"
              :task (shell "bash" "-lc" "clj-kondo --lint phoenix-dsl scripts")}

  fmt:zprint {:doc "Format with contemplative attention (80 columns)"
              :task (shell "bash" "-lc" "zprint -w **/*.{clj,cljs,edn} || true")}

  test:spec {:doc "Test specifications with awareness"
             :task (shell {:dir "phoenix-dsl"} "bash" "-lc" "bb -m phoenix.test")}

  phoenix:parse {:doc "Parse markdown teachings → ClojureScript data structures"
                 :task (shell {:dir "phoenix-dsl"} "bash" "-lc" "bb -m phoenix.markdown")}

  phoenix:spec {:doc "Validate data structures with clojure.spec awareness"
                :task (shell {:dir "phoenix-dsl"} "bash" "-lc" "bb -m phoenix.spec")}

  phoenix:generate {:doc "Transform data → Svelte components with Divine Grace"
                    :task (shell {:dir "phoenix-dsl"} "bash" "-lc" "bb -m phoenix.svelte")}

  build:phoenix-gen {:depends [phoenix:parse phoenix:spec phoenix:generate]}

  serve:localhost {:doc "Serve for local contemplative development"
                   :task (shell {:dir "web-grace"} "bash" "-lc" "npm pkg get name >/dev/null 2>&1 || npm init -y; npm i -D svelte @sveltejs/kit @sveltejs/adapter-auto vite; npx svelte-kit dev")}

  build:pages {:doc "Build static site for GitHub Pages community sharing"
               :task (shell {:dir "web-grace"} "bash" "-lc" "BASE_PATH=/foolsgoldtoshi-star-pond-highdesert npx svelte-kit build")}

  build:aws-server {:doc "Build NixOS container for AWS EKS production"
                    :task (shell "nix" "build" ".#aws-server-container")}

  build:all {:depends [build:phoenix-gen]}

  ci:verify {:depends [doctor lint:kondo fmt:zprint test:spec build:phoenix-gen]}

  deploy:aws-eks {:doc "Deploy to AWS EKS with NixOS + udw firewall"
                  :task (shell "bash" "-lc" "kubectl apply -f deploy/aws-eks/")}

  epub:kindle {:doc "Generate Kindle-optimized sacred technology guide"
               :task (do (println "🕯️ Creating Kindle-ready sacred technology guide...")
                         (generate-kindle-epub)
                         (println "📖 Kindle epub ready: build/sacred-technology-kindle.epub"))}

  epub:mobile {:doc "Generate mobile-optimized epub for smartphone reading"
               :task (do (println "📱 Creating mobile-optimized sacred technology guide...")
                         (generate-mobile-epub)
                         (println "📚 Mobile epub ready: build/sacred-technology-mobile.epub"))}

  community:serve {:doc "Start community learning server with sacred consciousness"
                   :task (do (println "🌙 Starting sacred technology community server...")
                             (shell "bb" "build:all")
                             (shell "bb" "serve"))}

  ci:verify {:depends [doctor lint build:gen]}}}

;; Sacred technology build system serving consciousness development
;; Built with contemplative attention by the pond-highdesert community
;; From digital exile to technological sovereignty through gentle learning